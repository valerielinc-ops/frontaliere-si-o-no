rules_version = '2';

// Firebase Storage security rules.
// Default-deny everything; only the explicitly allowed paths below are reachable.
service firebase.storage {
  match /b/{bucket}/o {

    // Candidate CV uploads from the publisher apply form.
    // - create (write): anyone may upload a small (<5MB) document/text file.
    //   The download URL is then written into the application's Firestore doc
    //   (firestore.rules guards that), and forwarded to the publisher via the
    //   forwardPublisherApplication Cloud Function.
    // - read: denied for clients — the CV is private and only reachable by the
    //   forward Cloud Function (Admin SDK) or the publisher via a signed URL.
    match /cv-uploads/{jobId}/{file} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/.*|text/.*');
      allow read: if false;
    }

    // Assisted-application CV uploads (#6406/#6408). Same shape as
    // cv-uploads/** above: clients may create, never read. The
    // scanAssistedApplicationCv Cloud Function (Admin SDK, bypasses these
    // rules) scans every upload and writes cvScanStatus onto the order doc;
    // the admin manual-submission queue (#6407) only surfaces orders whose
    // scan resolved to 'clean' — a rejected/pending scan keeps the file out
    // of any admin-visible flow even though the byte-level read rule below
    // (`false`, same as cv-uploads) already denies client reads outright.
    match /assisted-application-uploads/{orderId}/{file} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('application/.*|text/.*');
      allow read: if false;
    }

    // Journalist hero-image uploads for draft/queued articles (see
    // firestore.rules `journalist_articles`). Only the owning journalist may
    // write or read their own path; the publish pipeline reads via the Admin
    // SDK, which bypasses these rules entirely.
    match /journalist-uploads/{uid}/{articleId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default deny: any path not matched above is inaccessible.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
