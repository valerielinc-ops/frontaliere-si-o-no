{
  "enabledPlugins": {
    "marketing-skills@marketingskills": false,
    "context7@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "everything-claude-code@everything-claude-code": false,
    "superpowers@superpowers-dev": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ci/sibling-check-gate.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ci/pr-body-check-gate.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "( node \"$CLAUDE_PROJECT_DIR/scripts/prune-merged-worktrees.mjs\" --apply >/dev/null 2>&1 & ) || true"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-session-secrets.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/prune-merged-worktrees.mjs\" --apply --orphans-only 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "env": {
    "SKIP_FUEL_DAILY": "1",
    "SKIP_WEEKLY_EMPLOYERS": "1",
    "SKIP_JOB_MARKET_SNAPSHOT": "1",
    "SKIP_HEALTH_PREMIUMS": "1",
    "SKIP_ORPHAN_LANDINGS": "1",
    "SKIP_BORDER_WAIT": "1",
    "SKIP_CI_CHECK": "1",
    "FAST_BUILD": "1",
    "NODE_OPTIONS": "--max-old-space-size=12288"
  }
}
