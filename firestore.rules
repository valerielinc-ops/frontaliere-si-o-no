rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Social proof counter — public increment
    match /counters/{counterId} {
      allow read, write: if true;
    }

    // Saved simulations — owned by authenticated user
    match /simulations/{simId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Forum questions — public read, auth write/delete own
    match /forum_questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Forum answers — public read, auth write/delete own
    match /forum_answers/{answerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Newsletter subscribers — public subscribe/unsubscribe
    match /newsletter_subscribers/{email} {
      allow read, write: if true;

      // Engagement events (subscribe, confirm, click, open) — public append
      match /events/{eventId} {
        allow read, write: if true;
      }

      // Campaign delivery tracking — public write (Cloud Functions + client beacons)
      match /campaign_deliveries/{deliveryId} {
        allow read, write: if true;
      }

      // Private sub-collection — auth-gated, own data only
      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.token.email == email;
      }
    }

    // Feedback — owned by authenticated user
    match /feedback/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Contact submissions — anonymous create only
    match /contact_submissions/{docId} {
      allow create: if true;
    }

    // Salary survey — public
    match /salary_survey/{docId} {
      allow read, write: if true;
    }

    // Traffic data — public read only (writes via Admin SDK)
    match /trafficCurrent/{docId} {
      allow read: if true;
    }
    match /trafficHistory/{slug}/snapshots/{snapshotId} {
      allow read: if true;
    }

    // Collection-group reads for `alerts` (getUserAlerts + createAlert's per-user
    // limit check both run `collectionGroup('alerts').where('userId','==',uid)`).
    // Firestore does NOT apply the nested
    // `/job_alert_subscribers/{email}/alerts/{alertId}` rule to collection-group
    // queries, so without this top-level `{path=**}` rule every such read is
    // permission-denied — which silently broke BOTH listing and creating job
    // alerts (job_alert_subscribers frozen since 2026-04-25, ~21 GA4
    // `job_alert_cta_skipped:get_alerts_failed` events/day). Scoped to the
    // caller's own alerts via the denormalized userId.
    match /{path=**}/alerts/{alertId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Job alert subscribers — root doc per email, mirrors newsletter_subscribers.
    // Top-level doc is public-write (Cloud Functions + client init); engagement
    // counters are written by ESP webhooks via the Admin SDK.
    match /job_alert_subscribers/{email} {
      allow read, write: if true;

      // Search configurations — owned by authenticated user (denormalized userId).
      // The path is keyed by the user's email, so request.auth.token.email
      // gates writes to the user's own subscriber doc.
      match /alerts/{alertId} {
        allow read: if request.auth != null
          && (request.auth.uid == resource.data.userId
              || request.auth.token.email == email);
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId
          && request.auth.token.email == email;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId
          && request.auth.token.email == email;
      }

      // Per-alert delivery state — written by ESP webhooks (Admin SDK bypasses rules).
      match /alert_deliveries/{alertId} {
        allow read, write: if true;
      }

      // Raw ESP event log — written by webhooks (Admin SDK bypasses rules).
      match /events/{eventId} {
        allow read, write: if true;
      }
    }

    // User profiles — own data only (admin SDK writes bypass rules)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // Fuel prices — public read only (writes via Admin SDK from CI)
    match /fuelPrices/{docId} {
      allow read: if true;
    }

    // Config — public read + write for exchange rate cache (best-effort client-side caching)
    match /config/{docId} {
      allow read, write: if true;
    }

    // Exchange rate history — public read only (writes via daily cron job with Admin SDK)
    match /exchangeHistory/{docId} {
      allow read: if true;
    }

    // Job page views — public increment for popularity ranking
    match /job_views/{slug} {
      allow read: if true;
      allow write: if true;
    }

    // Article page views — public increment for newsletter "Most read" rotation
    match /article_views/{articleId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
