rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The site owner, named here for exactly one reason: the admin panel is the
    // only legitimate lister of a subscriber collection, and closing `list`
    // without it would have left the owner's own dashboard reading zero.
    //
    // Same identity the SPA already gates that panel with — App.tsx and
    // hooks/useUserState.ts both carry `ADMIN_EMAIL_WHITELIST =
    // ['valerielinc@gmail.com']`, a plain constant that is compiled into every
    // client bundle we publish, so repeating it here exposes nothing that is not
    // already public. What it does add is enforcement: until now that allowlist
    // decided which React tree rendered, never what Firestore would answer.
    //
    // `email_verified` is required on top of the address because this grant is
    // whole-collection enumeration, not one document. Firebase's default
    // one-account-per-email already blocks registering an address that has an
    // account, so the claim is defence in depth rather than the load-bearing
    // half — but it is one clause against a grant worth 8.605 people.
    function isSiteAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'valerielinc@gmail.com';
    }

    // Consent-field guard for newsletter_subscribers (#6378, phase 4 of
    // #5928). True if the incoming write touches any of the fields that
    // together form the art. 25 consent record — a change here is what an
    // unauthenticated forger would need to falsify.
    function consentFieldsTouched(newData, oldData) {
      return newData.diff(oldData).affectedKeys().hasAny([
        'consent_text', 'consent_text_version', 'consent_text_displayed',
        'consent_page_version', 'consent_act', 'consent_origin',
        'consent_method', 'consent_given', 'consent_given_at',
        'consent_source_url', 'consent_user_agent', 'consent_ip',
        'consent_ip_recorded_at',
      ]);
    }

    // Social proof counter — public increment (#5792).
    //
    // The only reader/writer is `counters/simulations`: SocialProofBadge.tsx
    // and AdminPanel.tsx `getDoc` it, services/firestoreService.ts
    // `registerSimulationForSocialProof` `setDoc`s it with `{ merge: true }`
    // writing exactly `total: increment(1)` + `updatedAt: serverTimestamp()`.
    // No client ever queries `collection('counters')`, so `list` was pure
    // enumeration surface with zero legitimate caller — closed outright,
    // same shape as `consulting_orders` below.
    //
    // `write: if true` let any visitor set `total` to an arbitrary number
    // (or delete the doc) instead of nudging it by one. `increment(1)` on a
    // missing field resolves to `1`, so first-write create and every
    // subsequent update both reduce to "the merged `total` is exactly one
    // more than what was there a moment ago" — `create` covers the
    // not-yet-existing doc (`resource == null` ⇒ prior total 0), `update`
    // covers every write after.
    match /counters/{counterId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['total', 'updatedAt'])
        && request.resource.data.total == 1;
      allow update: if request.resource.data.keys().hasOnly(['total', 'updatedAt'])
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if false;
    }

    // Saved simulations — owned by authenticated user
    match /simulations/{simId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Forum questions — public read, auth write/delete own
    match /forum_questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Forum answers — public read, auth write/delete own
    match /forum_answers/{answerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Newsletter subscribers — public subscribe/unsubscribe
    //
    // ENUMERATION IS CLOSED HERE (#5751, phase 2 of #5730 — which covered the
    // subcollections below and left their parent exactly as it found it).
    //
    // What `allow read, write: if true` meant: `read` is `get` PLUS `list`, and
    // nothing in the predicate could reject a query, so
    // `collection('newsletter_subscribers')` with no `where` was as permitted as
    // any filtered one. An unauthenticated browser holding the project id — which
    // ships in the client bundle, as it must — could page the whole list: address,
    // name, opt-in state, consent text, job context, behavioural signals. 8.605
    // documents.
    //
    // `get` deliberately stays public, and that is a finding, not an oversight.
    // The anonymous subscribe path READS this document before writing it:
    // services/newsletterSubscribers.ts's captureNewsletterSubscriber does a
    // `getDoc` to decide creation-vs-merge and to honour a recorded opt-out, and
    // `isNewsletterOptedOut` is consulted by six callers, of which
    // components/fisco/TaxCalendar.tsx (`tax_calendar_email`), JobBoard's email
    // unlock and PublisherPublishPage have no signed-in user at all. That guard
    // fails CLOSED, so a denied read would not surface as an error — it would
    // silently suppress every subscription from those forms and look like a quiet
    // week. Narrowing `get` therefore has to travel with moving the write behind a
    // callable (phase 3), not against the requirement that anonymous subscription
    // keep working.
    match /newsletter_subscribers/{email} {
      allow get: if true;
      // The admin panel is the only client that lists this collection
      // (components/pages/AdminPanel.tsx: a getCountFromServer on
      // `isActive == true`, and a limit(10) masked preview). Everything else that
      // reads many subscribers — scripts/send-newsletter.mjs and its siblings, the
      // ESP webhook cores — is Admin SDK and never evaluates this file.
      allow list: if isSiteAdmin();
      allow create: if true;

      // Field guard (#6378, phase 4 of #5928): `write: if true` let anyone who
      // knew a subscriber's email forge or overwrite `consent_*` on an
      // EXISTING document — falsifying the art. 25 consent record for a real
      // person, no session required. Non-consent fields (name, isActive, the
      // engagement counters) still update freely; a write only needs to pass
      // through the auth clause when it actually touches a consent_* key.
      // `request.auth.token.email.lower() == email` matches the identity
      // check already used for job_alert_subscribers (line ~243) and the
      // alerts subcollection below — the subscriber's own signed-in session
      // is always allowed to touch their own consent record.
      allow update: if !consentFieldsTouched(request.resource.data, resource.data)
        || (request.auth != null && request.auth.token.email.lower() == email);

      // Engagement events (subscribe, confirm, click, open) — append-only, and
      // never readable by a client.
      //
      // READ: no browser code path reads this subcollection. Verified by an
      // exhaustive sweep of services/, components/, hooks/, App.tsx and
      // index.tsx for getDoc/getDocs/query/onSnapshot/getCountFromServer/
      // collectionGroup against `events` — zero hits, and there is no
      // collectionGroup rule for `events` either (the only {path=**} rule in
      // this file targets `alerts`). Everything that consumes these documents
      // — scripts/lib/*, the ESP webhook cores under functions/src/ — runs on
      // the Admin SDK, which does not evaluate rules. So closing the read
      // removes the per-open/per-click forensics (source page, target URL,
      // geo_country, and the request metadata recorded by
      // functions/src/lib/requestForensics.js) from client reach at no cost to
      // any live path.
      //
      // CREATE-ONLY: all eight client writers are addDoc — an append. Nothing
      // in the tree updates or deletes an event document, so `write` was
      // strictly wider than the code needs. An engagement log that can be
      // rewritten after the fact is also not much of a log.
      match /events/{eventId} {
        allow read: if false;
        allow create: if true;
        allow update, delete: if false;
      }

      // Campaign delivery tracking — Admin SDK only.
      //
      // The comment this replaces named "client beacons", but there is no live
      // client writer: the sole one is App.tsx's /newsletter/click handler, and
      // nothing emits that URL. tests/newsletter-template-tracking.test.ts
      // asserts the templates never contain '/newsletter/click/' — they use
      // direct URLs, and open/click attribution arrives through the ESP
      // webhooks (functions/src/newsletter*WebhookCore.js) on the Admin SDK.
      // applyNewsletterDeliveryEvent, the other would-be writer, has zero
      // callers anywhere. No client reads these documents either (same sweep as
      // `events` above).
      match /campaign_deliveries/{deliveryId} {
        allow read, write: if false;
      }

      // Private sub-collection — auth-gated, own data only
      match /private/{docId} {
        allow read, write: if request.auth != null
          && request.auth.token.email.lower() == email;
      }
    }

    // Feedback — owned by authenticated user
    match /feedback/{docId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Contact submissions — anonymous create only
    match /contact_submissions/{docId} {
      allow create: if true;
    }

    // Salary survey — anonymous compensation benchmarks, aggregated
    // client-side into sector percentiles.
    //
    // `get`/`list` staying public is not a PII exposure: the only writer
    // (components/community/SalarySurvey.tsx's submitSurveyToFirestore) sends
    // sector/experience/canton/grossSalaryCHF/createdAt — no email, uid or
    // name is ever denormalised in. This is a compensation+role+canton
    // record, not a linkable identity, unlike newsletter_subscribers
    // (#5751/#5793). `loadSurveyResults` reads it back with an anonymous
    // `getDocs`/`orderBy`/`limit(500)` to render the results view, so `read`
    // has to stay open.
    //
    // `write: if true` was the actual hole: it let any visitor overwrite or
    // delete every submitted record, not just add their own. No client path
    // calls update or delete on this collection — closed outright. `create`
    // is validated to the same shape and salary bounds
    // (1'000–500'000 CHF/anno) the form already enforces, so a forged
    // document can't smuggle extra fields or nonsense figures into the
    // aggregation.
    match /salary_survey/{docId} {
      allow read: if true;
      allow create: if request.resource.data.sector is string
        && request.resource.data.experience is string
        && request.resource.data.canton is string
        && request.resource.data.grossSalaryCHF is number
        && request.resource.data.grossSalaryCHF >= 1000
        && request.resource.data.grossSalaryCHF <= 500000;
      allow update, delete: if false;
    }

    // Traffic data — public read only (writes via Admin SDK)
    match /trafficCurrent/{docId} {
      allow read: if true;
    }
    match /trafficHistory/{slug}/snapshots/{snapshotId} {
      allow read: if true;
    }

    // Collection-group reads for `alerts` (getUserAlerts + createAlert's per-user
    // limit check both run `collectionGroup('alerts').where('userId','==',uid)`).
    // Firestore does NOT apply the nested
    // `/job_alert_subscribers/{email}/alerts/{alertId}` rule to collection-group
    // queries, so without this top-level `{path=**}` rule every such read is
    // permission-denied — which silently broke BOTH listing and creating job
    // alerts (job_alert_subscribers frozen since 2026-04-25, ~21 GA4
    // `job_alert_cta_skipped:get_alerts_failed` events/day). Scoped to the
    // caller's own alerts via the denormalized userId.
    match /{path=**}/alerts/{alertId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }

    // Job alert subscribers — root doc per email, mirrors newsletter_subscribers.
    // Top-level doc is public-write (Cloud Functions + client init); engagement
    // counters are written by ESP webhooks via the Admin SDK.
    //
    // Enumeration closed in the same pass as newsletter_subscribers (#5751), and
    // for the same reason it was closed there: `read` covered `list`, no
    // predicate could reject a query, so the job-alert list was walkable by
    // anyone. Splitting the pair across two PRs would have left half of one class
    // of PII open while the other half was being repaired.
    //
    // Unlike newsletter_subscribers, `get` takes the scoped form outright: NO
    // browser code path reads this document. services/jobAlertService.ts only
    // ever `setDoc`s it (merge, to guarantee the parent exists), and the
    // preferences centre reads the `alerts` subcollection below, never the root
    // — so there is no anonymous read to preserve here. The form matches the two
    // sibling rules in this same block.
    match /job_alert_subscribers/{email} {
      allow get: if request.auth != null
        && request.auth.token.email.lower() == email;
      allow list: if false;
      allow write: if true;

      // Search configurations — owned by authenticated user (denormalized userId).
      // The path is keyed by the user's email, so request.auth.token.email
      // gates writes to the user's own subscriber doc.
      match /alerts/{alertId} {
        allow read: if request.auth != null
          && (request.auth.uid == resource.data.userId
              || request.auth.token.email.lower() == email);
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId
          && request.auth.token.email.lower() == email;
        // UPDATE takes the same disjunction `read` already takes, and #5876 is
        // why. `update` used to require `uid == resource.data.userId` AND the
        // email match — but the 6.295 alerts created by the travaso
        // (functions/src/jobAlertBackfillCore.js, `userId: data?.user_id ||
        // null`) were built from newsletter documents that had no `user_id`:
        // measured on production 2026-08-14, **0 of 6.295 carry one**. Every
        // client update on a travaso alert was therefore permission-denied, for
        // every signed-in owner, including the "record the consent I just gave"
        // write this rule change exists to allow — a feature that would have
        // shipped green and moved its metric by exactly zero.
        //
        // The email match alone is not a weakening: the document lives under
        // `job_alert_subscribers/{that person's own email}`, which is the same
        // argument `read` above already accepts, and the token's email is
        // verified by Firebase Auth. `create` deliberately keeps the AND — a
        // NEW document must denormalise the writer's own uid, or the
        // (userId, active, createdAt) collection-group query that lists alerts
        // would stop seeing what the client just wrote.
        allow update, delete: if request.auth != null
          && request.auth.token.email.lower() == email
          && (request.auth.uid == resource.data.userId
              || resource.data.userId == null);
      }

      // Per-alert delivery state and the raw ESP event log. Both are written by
      // the webhooks under functions/src/ and read by scripts/send-job-alerts.mjs
      // — all Admin SDK, which bypasses these rules entirely, exactly as the
      // previous comments already said. The public grant was therefore doing no
      // work for any caller: no browser code path touches either subcollection
      // (the only client access to job_alert_subscribers is the root doc and
      // `alerts`, in services/jobAlertService.ts and the preferences
      // controller).
      //
      // Closed here rather than in a follow-up because they are the same
      // construct as newsletter_subscribers' `events` / `campaign_deliveries`
      // above, holding the same category of data — `events` is the raw ESP log,
      // with the same per-open and per-click request metadata — and the sibling
      // sweep required before opening a PR (AGENTS.md #6) is what surfaced them.
      // Splitting the pair across two PRs would leave half the class open for no
      // reason.
      match /alert_deliveries/{alertId} {
        allow read, write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // User profiles — own data only (admin SDK writes bypass rules)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;

      // Saved jobs (registered-account "Salvati" feature) — owner-only CRUD,
      // no cross-uid read. Client enforces the 100-entry cap; delete is used
      // by unsave and by the account-deletion cascade cleanup function.
      match /savedJobs/{jobId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Fuel prices — public read only (writes via Admin SDK from CI)
    match /fuelPrices/{docId} {
      allow read: if true;
    }

    // Config — public read + write for exchange rate cache (best-effort client-side caching)
    match /config/{docId} {
      allow read, write: if true;
    }

    // Exchange rate history — public read only (writes via daily cron job with Admin SDK)
    match /exchangeHistory/{docId} {
      allow read: if true;
    }

    // Job page views — public increment for popularity ranking
    match /job_views/{slug} {
      allow read: if true;
      allow write: if true;
    }

    // Article page views — public increment for newsletter "Most read" rotation
    match /article_views/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Publisher portal (paid job postings) ───────────────────────────────
    // Status machine: a client may create/edit an ad as 'draft' or
    // 'pending_payment' but may NEVER self-promote it to 'paid'/'active' — that
    // flip happens only via the Stripe webhook running with the Admin SDK
    // (which bypasses these rules). This prevents free self-publishing.
    function isSignedIn() { return request.auth != null; }
    // Free tier may self-publish (status 'published') but ONLY as a plain crawler-
    // style job: never featured, apply must be an external link. Sponsored tier
    // may only reach 'draft'/'pending_payment' from the client — the Stripe webhook
    // (Admin SDK) is the only thing that sets 'paid'.
    function freeJobOk(d) {
      return d.tier == 'free'
        && (d.status == 'draft' || d.status == 'published')
        && d.featured != true
        && d.apply.mode == 'external_url';
    }
    function sponsoredJobOk(d) {
      return d.tier == 'sponsored'
        && (d.status == 'draft' || d.status == 'pending_payment');
    }
    // Piano Azienda ads: same client-write envelope as sponsored (draft →
    // pending_payment); featured/paid state is set server-side via the webhook.
    function aziendaJobOk(d) {
      return d.tier == 'azienda'
        && (d.status == 'draft' || d.status == 'pending_payment');
    }
    function clientJobWriteOk(d) {
      return freeJobOk(d) || sponsoredJobOk(d) || aziendaJobOk(d);
    }
    // Pure CONTENT edit on ANY status (fix a typo, update the description on an
    // already-paid ad). Allowed only when status / tier / owner are UNCHANGED —
    // status transitions stay gated by clientJobWriteOk, and the webhook/Admin SDK
    // still owns paid/expired flips. A free ad still cannot become featured here.
    function contentEditOk(prev, next) {
      return next.publisherUid == prev.publisherUid
        && next.tier == prev.tier
        && next.status == prev.status
        && (next.tier != 'free' || next.featured != true)
        // Billing is per-location and the Stripe subscription quantity is fixed at
        // checkout. A content edit must NOT change the location count (would emit
        // unbilled per-location pages). Adding locations requires a new checkout.
        && next.locations.size() == prev.locations.size();
    }

    // Publisher accounts / company profile — owner-only (billing data is private;
    // public company info is mirrored into the job slice, not read from here).
    match /publishers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      // No client delete — account closure handled by a Cloud Function.
    }

    // Publisher job ads. Read = owner (dashboard); the public surface is the
    // CDN-offloaded overlay file, not a live Firestore read.
    match /publisher_jobs/{jobId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid == resource.data.publisherUid);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.publisherUid
        && clientJobWriteOk(request.resource.data);
      // Owner may either (a) drive a status transition while not sponsored-paid
      // (draft → pending_payment etc., via clientJobWriteOk), or (b) make a pure
      // content edit (typo / description fix) on ANY status as long as it does
      // NOT change owner / tier / status (contentEditOk). Neither path can
      // reassign ownership, flip a sponsored ad to paid, nor turn a free ad into
      // a featured one — those remain Admin-SDK-only.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.publisherUid
        && request.resource.data.publisherUid == resource.data.publisherUid
        && (
          (request.resource.data.tier == resource.data.tier
            && clientJobWriteOk(request.resource.data))
          || contentEditOk(resource.data, request.resource.data)
        );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.publisherUid;
    }

    // Orders / subscription mirror — owner read; create on checkout init; all
    // state transitions (paid, renewed, cancelled, refunded) written by the
    // Stripe webhook via Admin SDK (bypasses rules).
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid == resource.data.publisherUid);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.publisherUid;
      // No client update/delete — Admin SDK only.
    }

    // Consulting-session payments (/consulenza/, replaces the dead Calendly
    // links). Public/anonymous — no Firebase Auth account required to pay for
    // a session. Doc id = Stripe Checkout Session id: an unguessable
    // capability token carried in the success-redirect URL, so a plain `get`
    // is safe while `list` stays closed (no PII enumeration).
    match /consulting_orders/{orderId} {
      allow get: if true;
      allow list: if false;
      // Only the Stripe webhook (Admin SDK, bypasses rules) creates a paid order.
      allow create: if false;
      // Exactly one client update: submitting the intake form once, only
      // after real payment landed, with money/identity fields frozen — same
      // envelope shape as publisher_jobs' contentEditOk above.
      allow update: if resource.data.status == 'paid'
        && resource.data.detailsSubmitted != true
        && request.resource.data.detailsSubmitted == true
        && request.resource.data.topic is string
        && request.resource.data.description is string
        && request.resource.data.preferredDateStart is string
        && request.resource.data.preferredDateEnd is string
        && request.resource.data.contactName is string
        && request.resource.data.status == resource.data.status
        && request.resource.data.tier == resource.data.tier
        && request.resource.data.amountTotal == resource.data.amountTotal
        && request.resource.data.customerEmail == resource.data.customerEmail;
      allow delete: if false;
    }

    // Per-ad analytics counters (views, apply clicks). Public increment like
    // job_views/article_views; owner reads aggregates in the dashboard.
    match /publisher_job_events/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    // Per-company crawled-traffic metrics (candidati gratuiti inviati), shown in
    // the publisher dashboard. Aggregate counts only (no PII). Written exclusively
    // by the daily cron via the Admin SDK (which bypasses rules) → client writes denied.
    match /employer_crawled_traffic/{companyKey} {
      allow read: if true;
      allow write: if false;
    }

    // Candidate applications (in-house / forward modes). Contains PII, so reads
    // are restricted to the publisher who owns the target job (denormalized
    // publisherUid) — never public. Create is open (candidate submits) but the
    // explicit-consent flag is required (GDPR: forwarding PII to a third-party
    // employer is a distinct processing purpose from the site's silent consent).
    match /applications/{appId} {
      // The owning publisher reads applicants; the candidate reads their own
      // submissions (denormalised candidateUid) to list them in their profile.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.publisherUid
        || request.auth.uid == resource.data.candidateUid
      );
      // Anonymous candidates may submit, but only a well-formed, consented payload:
      // required fields present + explicit consent. (Volume/abuse throttling is
      // enforced upstream by reCAPTCHA on the form, not expressible in rules.)
      // candidateUid is optional (logged-out applicants omit/null it) but, when
      // present, MUST be the caller's own uid — a candidate can't attribute an
      // application to someone else.
      allow create: if request.resource.data.consentGiven == true
        && request.resource.data.consentText is string
        && request.resource.data.jobId is string
        && request.resource.data.publisherUid is string
        && request.resource.data.candidateEmail is string
        && request.resource.data.candidateName is string
        && (
          !('candidateUid' in request.resource.data)
          || request.resource.data.candidateUid == null
          || (isSignedIn() && request.resource.data.candidateUid == request.auth.uid)
        );
      // No client update/delete — retention purge handled by a Cloud Function.
    }

    // Journalist role grants. Membership (not content) — a doc existing with
    // active==true is what gates the /journalist_articles collection below.
    // Only the manageJournalistRole Cloud Function (Admin SDK, admin-gated)
    // may create/update these; a journalist may read their own grant to
    // render the dashboard gate.
    match /journalists/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    function isActiveJournalist() {
      return exists(/databases/$(database)/documents/journalists/$(request.auth.uid))
        && get(/databases/$(database)/documents/journalists/$(request.auth.uid)).data.active == true;
    }

    // Journalist-authored articles awaiting/after entry into the same
    // multi-locale generation pipeline used for automated content (see
    // scripts/publish-journalist-article.mjs). Client (the journalist) may
    // only ever hand the pipeline a 'draft' or 'queued' doc — the transition
    // to 'published' / 'failed', and all cross-locale content, is written
    // exclusively by that script via the Admin SDK.
    function journalistArticleWriteOk(prev, next) {
      return next.authorUid == prev.authorUid
        && next.id == prev.id
        // Cross-locale content is written exclusively by the Admin-SDK publish
        // pipeline (translateArticle) — a client must never be able to set it.
        && !('en' in next.content) && !('de' in next.content) && !('fr' in next.content)
        && (prev.status == 'draft'
          ? (next.status == 'draft' || next.status == 'queued')
          : (prev.status == 'failed'
            ? (next.status == 'failed' || next.status == 'queued')
            : false));
    }
    match /journalist_articles/{articleId} {
      // `resource == null` (doc doesn't exist yet) must be allowed to read-through
      // to a clean "not found" — otherwise dereferencing `.data` on a null resource
      // throws a rules-evaluation error, which Firestore surfaces to the client as
      // PERMISSION_DENIED. That broke both the new-draft id-collision check in
      // createDraft() and the dashboard's slug-availability check, since both
      // call getDoc() on an article id that doesn't exist yet for a brand-new draft.
      allow read: if isSignedIn() && (resource == null || request.auth.uid == resource.data.authorUid);
      allow create: if isSignedIn()
        && isActiveJournalist()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.authorUid
        && isActiveJournalist()
        && journalistArticleWriteOk(resource.data, request.resource.data);
      // A draft (never submitted) may be deleted by its author; once queued
      // or beyond, the pipeline/admin own the record's lifecycle.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.authorUid
        && resource.data.status == 'draft';
    }

    // Admin-editable overrides for the static AI-persona registry
    // (data/authors.ts) — bio/photo/social patches keyed by author slug.
    // Same class of data as data/authors.ts itself (fully public, bundled
    // into every client build already), so public read is not a new
    // exposure. Only the manageRedazioneAdmin Cloud Function (Admin SDK,
    // admin-gated) may write.
    match /author_profiles/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Admin-set author reassignment for a single AI-catalog article
    // (data/blog-articles-data.ts entry), keyed by article id. Same
    // write-only-via-Cloud-Function pattern as author_profiles above.
    match /article_author_overrides/{articleId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
