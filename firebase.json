{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "newsletter-webhooks",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "public": "infra/firebase-hosting-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/(?P<p>(?:[^_]|_[^_]).*)?$",
        "destination": "https://frontaliereticino.ch/:p",
        "type": 301
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    }
  }
}
