#!/bin/sh
# Post-commit hook: Track user-facing commits for WhatsNew release notes.
#
# Tracks feat/fix commits into data/pending-releases.json.
# WhatsNew is auto-generated in the pre-push hook every 20 accumulated commits.
#
# Detects conventional-commit prefixes (feat:, fix:) and appends metadata
# to data/pending-releases.json so the WhatsNewModal can be updated
# periodically (manually or via the pre-push reminder).
#
# Non-user-facing commits are silently skipped: automated content pushes, the
# non-product conventional types (chore/refactor/ci/docs/test/style/build/perf),
# and — since #5169 follow-up — any feat/fix whose SCOPE is development
# machinery (ci, deploy, workflows, gates, deps, …). See
# scripts/lib/whats-new-classify.mjs, which owns those rules and is unit-tested.

PENDING_FILE="data/pending-releases.json"

# Get the latest commit info
COMMIT_MSG=$(git log -1 --pretty=format:'%s')
COMMIT_HASH=$(git log -1 --pretty=format:'%h')
COMMIT_DATE=$(git log -1 --date=format:'%Y-%m-%d' --pretty=format:'%ad')
COMMIT_AUTHOR=$(git log -1 --pretty=format:'%an')

# ── Classify the commit ──
# Single source: scripts/lib/whats-new-classify.mjs. The rules used to live here
# as `case` statements that filtered on the conventional-commit TYPE only, so a
# `fix(ci)` / `fix(seo-gates)` — pure build machinery — was queued for a modal
# that site visitors read. Scope is the missing signal, and the shell is the
# wrong place to keep a list that needs a test. The helper always exits 0 and
# always prints JSON; if it cannot run at all we skip, because the safe default
# for "should this reach users?" is no.
CLASSIFY=$(node scripts/lib/whats-new-classify.mjs "$COMMIT_MSG" 2>/dev/null) || exit 0
[ -z "$CLASSIFY" ] && exit 0

USER_FACING=$(printf '%s' "$CLASSIFY" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{process.stdout.write(String(JSON.parse(s).userFacing))}catch{process.stdout.write('false')}})")
[ "$USER_FACING" = "true" ] || exit 0

RELEASE_TYPE=$(printf '%s' "$CLASSIFY" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{process.stdout.write(JSON.parse(s).type||'')}catch{process.stdout.write('')}})")
SCOPE=$(printf '%s' "$CLASSIFY" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{process.stdout.write(JSON.parse(s).scope||'')}catch{process.stdout.write('')}})")
DESC=$(printf '%s' "$CLASSIFY" | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{process.stdout.write(JSON.parse(s).description||'')}catch{process.stdout.write('')}})")

[ -z "$RELEASE_TYPE" ] && exit 0
[ -z "$DESC" ] && DESC="$COMMIT_MSG"

# ── Create or append to pending-releases.json ──
# Initialize file if it doesn't exist
if [ ! -f "$PENDING_FILE" ]; then
  echo '[]' > "$PENDING_FILE"
fi

# Use node to safely manipulate JSON.
#
# Every value crosses into node through the ENVIRONMENT, never by being pasted
# into the script text. The previous version interpolated them inside single-
# quoted JS string literals, so one apostrophe in a commit message closed the
# literal and the whole script died with a SyntaxError — the entry was dropped
# and nothing said so, because the success message is printed only on exit 0.
# Italian subjects hit this constantly ("e'", "l'articolo", "un'ora"), and so
# would any author named O'Brien. Caught 2026-08-06 on a commit whose subject
# contained "e' arrivato".
WN_FILE="$PENDING_FILE" \
WN_HASH="$COMMIT_HASH" \
WN_DATE="$COMMIT_DATE" \
WN_TYPE="$RELEASE_TYPE" \
WN_SCOPE="$SCOPE" \
WN_DESC="$DESC" \
WN_AUTHOR="$COMMIT_AUTHOR" \
WN_MSG="$COMMIT_MSG" \
node -e '
const fs = require("fs");
const env = process.env;
const file = env.WN_FILE;
let entries = [];
try { entries = JSON.parse(fs.readFileSync(file, "utf8")); } catch { entries = []; }
if (!Array.isArray(entries)) entries = [];

// Avoid duplicate entries for the same commit
if (entries.some((e) => e.hash === env.WN_HASH)) process.exit(0);

entries.push({
  hash: env.WN_HASH,
  date: env.WN_DATE,
  type: env.WN_TYPE,
  scope: env.WN_SCOPE || "",
  description: env.WN_DESC || "",
  author: env.WN_AUTHOR,
  fullMessage: env.WN_MSG || "",
});

fs.writeFileSync(file, JSON.stringify(entries, null, 2) + "\n");
'
WN_STATUS=$?

if [ "$WN_STATUS" -eq 0 ]; then
  PENDING_COUNT=$(WN_FILE="$PENDING_FILE" node -e 'try{console.log(JSON.parse(require("fs").readFileSync(process.env.WN_FILE,"utf8")).length)}catch{console.log(0)}')
  echo "📋 WhatsNew: tracked user-facing commit ($RELEASE_TYPE) — $PENDING_COUNT pending entries"
  echo "   Pre-push auto-sync is enabled (update-whats-new -- --apply + auto-commit)."
else
  # Say it. A dropped entry used to look exactly like a commit that was never
  # user-facing, which is why this went unnoticed.
  echo "⚠️  WhatsNew: could not record this commit (node exited $WN_STATUS) — entry NOT tracked." >&2
fi
