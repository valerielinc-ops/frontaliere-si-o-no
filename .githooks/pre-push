#!/usr/bin/env bash
# Sibling-patterns gate (issue #3809 / AGENTS.md #6).
#
# Structural enforcement for the recurring reviewer-finding/sibling-class-fix
# bucket: fixers must inspect untouched sibling files BEFORE pushing, not after
# the reviewer fires 🔴 post-PR-open (which costs an extra review cycle).
#
# Runs check-sibling-patterns.mjs: prints every untouched file that shares a
# distinctive construct with the diff (SCREAMING_SNAKE, camelCase helper, kebab
# import, literal slug).  Always exits 0 — see the ADVISORY note below.
#
# ADVISORY dal 2026-09-04 (istruzione diretta del proprietario): questo hook
# STAMPA i candidati e lascia passare il push. Non blocca piu'.
#
# Perche': qui non c'e' body da leggere, quindi l'unica uscita era un
# `git push --no-verify` — cioe' un gate che non si puo' soddisfare, solo
# aggirare, e che fa fallire `git push` con un nudo
# `error: failed to push some refs` senza nemmeno stampare la ragione a chi
# usa un client che non mostra stdout dell'hook. Un gate la cui unica risposta
# corretta e' il bypass insegna a bypassare, e il bypass e' indiscriminato:
# spegne l'hook per l'intero push, non per il candidato che hai valutato.
#
# L'ENFORCEMENT NON SPARISCE, si sposta dove e' soddisfacibile:
#   • `scripts/ci/sibling-check-gate.mjs` (PreToolUse su `gh pr create`) legge
#     il body della PR e blocca l'apertura finche' ogni candidato non e'
#     dichiarato falso positivo per-file in `## Non implementato`;
#   • il reviewer fa comunque 🔴 sibling-class-fix sulla PR aperta.
# L'output qui sotto resta perche' vederlo PRIMA di scrivere il body e' utile:
# e' un promemoria, non piu' una porta chiusa.
set -euo pipefail

# ── CI automation guard (article-generation outage 2026-07-08→10) ──────────
# npm ci's `prepare` script sets core.hooksPath=.githooks inside EVERY GitHub
# Actions job as well, so this gate also fired on data-refresh workflows that
# push generated content (articles, crawler data) straight to main. Those are
# not pre-PR dev pushes: a generated article touches ~13 files under
# services/** whose boilerplate is shared by every sibling article file, so
# the strict gate rejected the push 10/10 times (run 29090019854: 10871
# candidates → exit 1 → "Article is LOST") and article production dropped to
# zero. Skip the gate when running under GitHub Actions AND every pushed ref
# targets main — issue-fix agents push claude/* branches, so the gate keeps
# firing for the pre-PR pushes it was designed for.
if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
  any_ref=0
  all_main=1
  while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ -z "$remote_ref" ] && continue
    any_ref=1
    if [ "$remote_ref" != "refs/heads/main" ]; then all_main=0; fi
  done
  if [ "$any_ref" = "1" ] && [ "$all_main" = "1" ]; then
    echo "sibling-gate: skipped (GitHub Actions automated push to main)"
    exit 0
  fi
fi

# Niente `--strict`: senza quel flag lo script stampa i candidati ed esce 0.
node scripts/ci/check-sibling-patterns.mjs
